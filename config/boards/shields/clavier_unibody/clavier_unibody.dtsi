#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * 回路図マトリクス基準のトランスフォーム定義（左右一体・単一マイコン版）。
     * KiCad基板データ（Unibody_64keys）から実測した配線どおりに、
     * Row0〜4（5行）× Col0〜15（16列）の格子へ、そのままインデックス 0〜67 を割り当てます。
     * Row4（親指クラスタ）は Col6〜9 の4キーのみが実装されています。
     *
     * この並び順は config/clavier.json の layout 配列、および
     * clavier_unibody.keymap の bindings 配列と1対1で対応している必要があります
     * （インデックス i の物理キー = layout[i] = bindings[i]）。
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <5>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)  // Row0 (0-15)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)  // Row1 (16-31)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)  // Row2 (32-47)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15)  // Row3 (48-63)
            RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)                                                                                                              // Row4 親指 (64-67)
        >;
    };
};
